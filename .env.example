# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  Never commit .env to Git.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=dealership

# pgAdmin GUI
PGADMIN_EMAIL=admin@dealership.local
PGADMIN_PASSWORD=changeme_pgadmin

# Gemini (enrichment + embeddings) — get key at aistudio.google.com
GEMINI_API_KEY=

# Cohere (reranking — Phase 3)
COHERE_API_KEY=

# App settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=changeme_secret_key_32chars_min

# Embedding model (768 dims for Gemini text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768

# Vector DB collection name
QDRANT_COLLECTION=vehicles_v1
