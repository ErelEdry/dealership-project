# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  Never commit .env to Git.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=dealership

# pgAdmin GUI
PGADMIN_EMAIL=admin@dealership.local
PGADMIN_PASSWORD=changeme_pgadmin

# Groq (LLM enrichment, free tier) — get a key at console.groq.com/keys
# Required to run the pipeline; search works without it.
GROQ_API_KEY=

# Cohere (reserved for a future neural reranker — currently unused)
COHERE_API_KEY=

# App settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=changeme_secret_key_32chars_min

# Embeddings run locally via FastEmbed (BAAI/bge-base-en-v1.5, 768 dims) — no
# key needed. Leave EMBEDDING_MODEL / EMBEDDING_DIMENSIONS unset to use the
# defaults in backend/app/core/config.py; overriding them requires re-embedding.

# Vector DB collection name
QDRANT_COLLECTION=vehicles_v1
